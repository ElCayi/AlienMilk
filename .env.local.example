# Copia este archivo como .env.local y completa tus credenciales locales.
DB_USER=TU_USUARIO_MYSQL
DB_PASS=TU_PASSWORD_MYSQL

# Opcional: permite probar el frontend desde otro origen.
# CORS_ORIGINS=http://127.0.0.1:4300,http://localhost:4300

# Opcional: aviso por correo de cada solicitud de los formularios (docs/formularios.md).
# Sin servidor y destino, el aviso queda apagado y las solicitudes solo se ven en /admin.
# Con Gmail: verificación en dos pasos y una "contraseña de aplicación", nunca la normal.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_USERNAME=cuenta-que-envia@gmail.com
# SPRING_MAIL_PASSWORD=CONTRASENA_DE_APLICACION
# AVISOS_CORREO_DESTINO=quien-recibe-los-avisos@example.com
# Remitente, si no es la propia cuenta SMTP (p. ej. un remitente verificado en un servicio de envío).
# AVISOS_CORREO_REMITENTE=avisos@example.com
# AVISOS_CORREO_PANEL=http://127.0.0.1:4300/admin

# Opcional: cobro de la tienda con Stripe Checkout (docs/tienda.md). Sin clave, la tienda confirma
# los pedidos sin cobrar. En desarrollo, siempre las del entorno de prueba (sk_test_…).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secreto de los avisos (webhooks). En local lo da `stripe listen --print-secret`.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Adónde vuelve el comprador desde la página de pago.
# TIENDA_URL=http://127.0.0.1:4300
